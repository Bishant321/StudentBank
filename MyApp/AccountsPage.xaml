<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MyApp.Models"
             x:Class="MyApp.AccountsPage"
             Title="Accounts"
             BackgroundColor="#F4F7F6">
    <ScrollView>
        <VerticalStackLayout Padding="22,24" Spacing="18">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Accounts" FontSize="28" FontAttributes="Bold" TextColor="#123B32" />
                    <Label Text="StudentBank coursework demo ledger" FontSize="14" TextColor="#64736E" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Refresh" Clicked="OnRefreshClicked" BackgroundColor="#E4F2EC" TextColor="#08765B" />
            </Grid>

            <CollectionView x:Name="DemoAccountsView" ItemsSource="{Binding DemoAccounts}" SelectionMode="None" HeightRequest="180">
                <CollectionView.EmptyView>
                    <Label Text="No StudentBank demo accounts yet. Create one below." TextColor="#64736E" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:BankingAccount">
                        <Border Padding="16" Margin="0,0,0,10" BackgroundColor="White" Stroke="#DFE9E4" StrokeShape="RoundRectangle 18">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Label Text="{Binding HolderName}" FontSize="16" FontAttributes="Bold" TextColor="#123B32" />
                                <Label Grid.Column="1" Text="{Binding Currency}" FontSize="13" TextColor="#64736E" />
                                <Label Grid.Row="1" Text="{Binding Balance, StringFormat='{0:N2}'}" FontSize="22" FontAttributes="Bold" TextColor="#08765B" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding DisplayName}" FontSize="11" TextColor="#64736E" VerticalOptions="End" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border Padding="16" BackgroundColor="#E7F3EE" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Create a demo account" FontSize="17" FontAttributes="Bold" TextColor="#164A3B" />
                    <Entry x:Name="HolderNameEntry" Placeholder="Account name" />
                    <Picker x:Name="CurrencyPicker" Title="Currency">
                        <Picker.Items><x:String>GBP</x:String><x:String>USD</x:String><x:String>EUR</x:String></Picker.Items>
                    </Picker>
                    <Button Text="Create empty account" Clicked="OnCreateAccountClicked" Style="{StaticResource PrimaryButtonStyle}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" BackgroundColor="White" Stroke="#DFE9E4" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="8">
                    <Label Text="External bank (TrueLayer sandbox)" FontSize="17" FontAttributes="Bold" TextColor="#164A3B" />
                    <Label Text="Connect through the provider's sandbox consent flow. Never enter your bank password in StudentBank. Sandbox data is not your real bank account." FontSize="13" TextColor="#587169" />
                    <Button Text="Connect a test bank" Clicked="OnConnectBankClicked" BackgroundColor="#E4F2EC" TextColor="#08765B" />
                    <Entry x:Name="AuthorizationCodeEntry" Placeholder="Paste the sandbox authorization code" />
                    <Button Text="Finish sandbox connection" Clicked="OnFinishConnectClicked" Style="{StaticResource PrimaryButtonStyle}" />
                    <Label x:Name="ExternalBankStatus" FontSize="12" TextColor="#64736E" />
                </VerticalStackLayout>
            </Border>

            <CollectionView x:Name="ExternalAccountsView" ItemsSource="{Binding ExternalAccounts}" SelectionMode="None" HeightRequest="280">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ExternalBankAccount">
                        <Border Padding="16" Margin="0,0,0,10" BackgroundColor="White" Stroke="#DFE9E4" StrokeShape="RoundRectangle 18">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Provider}" FontSize="12" TextColor="#64736E" />
                                <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="#123B32" />
                                <Label Text="{Binding Currency}" FontSize="12" TextColor="#64736E" />
                                <Label Text="{Binding Balance, StringFormat='{0:N2}'}" FontSize="22" FontAttributes="Bold" TextColor="#08765B" />
                                <Label Text="Recent provider transactions (last 30 days)" FontSize="12" FontAttributes="Bold" TextColor="#455D56" />
                                <Label Text="{Binding RecentActivity}" FontSize="12" TextColor="#64736E" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
