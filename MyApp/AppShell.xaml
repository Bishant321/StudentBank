<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MyApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MyApp"
    Title="StudentBank"
    FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="Home" Route="Home" ContentTemplate="{DataTemplate local:MainPage}" />
        <ShellContent Title="Accounts" Route="Accounts" ContentTemplate="{DataTemplate local:AccountsPage}" />
        <ShellContent Title="Assistant" Route="Assistant" ContentTemplate="{DataTemplate local:AssistantPage}" />
    </TabBar>
</Shell>
