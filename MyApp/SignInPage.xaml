<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyApp.SignInPage"
             Title="Sign in"
             BackgroundColor="#F4F7F6">
    <ScrollView>
        <VerticalStackLayout Padding="26,44" Spacing="18" VerticalOptions="Center">
            <Label Text="StudentBank" FontSize="30" FontAttributes="Bold" TextColor="#123B32" />
            <Label Text="Sign in to view your StudentBank demo accounts, or create a coursework demo account." FontSize="15" TextColor="#64736E" />
            <Entry x:Name="FullNameEntry" Placeholder="Full name" IsVisible="False" />
            <Entry x:Name="EmailEntry" Placeholder="Email" Keyboard="Email" TextTransform="Lowercase" />
            <Entry x:Name="PasswordEntry" Placeholder="Password (8+ characters)" IsPassword="True" />
            <Label x:Name="StatusLabel" FontSize="13" TextColor="#A33A32" IsVisible="False" />
            <Button x:Name="SubmitButton" Text="Sign in" Clicked="OnSubmitClicked" Style="{StaticResource PrimaryButtonStyle}" HeightRequest="52" />
            <Button x:Name="ModeButton" Text="Create a demo account" Clicked="OnModeClicked" BackgroundColor="Transparent" TextColor="#08765B" />
            <Label Text="Coursework prototype only. Do not use real bank credentials or enter real financial information." FontSize="12" TextColor="#64736E" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
