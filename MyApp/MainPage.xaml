<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MyApp.Models"
             x:Class="MyApp.MainPage"
             Title="Home"
             BackgroundColor="#F4F7F6">
    <Grid RowDefinitions="*">
        <ScrollView>
            <VerticalStackLayout Padding="22,18,22,28" Spacing="22">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Good morning," FontSize="14" TextColor="#64736E" />
                        <Label Text="Bishant" FontSize="25" FontAttributes="Bold" TextColor="#123B32" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" WidthRequest="48" HeightRequest="48" BackgroundColor="#E1F1EB"
                            StrokeThickness="0" StrokeShape="RoundRectangle 24" VerticalOptions="Center">
                        <Label Text="B" FontSize="20" FontAttributes="Bold" TextColor="#08765B"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <Border Padding="22" BackgroundColor="#08765B" StrokeThickness="0" StrokeShape="RoundRectangle 24">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="TOTAL BALANCE" FontSize="12" CharacterSpacing="1.2" TextColor="#D1EFE4" />
                            <Button Grid.Column="1" Text="Hide" Clicked="OnToggleBalanceClicked"
                                    BackgroundColor="Transparent" TextColor="White" Padding="6,0"
                                    MinimumHeightRequest="36" MinimumWidthRequest="48" />
                        </Grid>
                        <Label x:Name="BalanceLabel" Text="£2,450.75" FontSize="35" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Sample balance · Demo account" FontSize="13" TextColor="#D1EFE4" />
                        <Grid ColumnDefinitions="*,*" Margin="0,10,0,0" ColumnSpacing="12">
                            <Border Padding="12" BackgroundColor="#21866E" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="Everyday account" FontSize="12" TextColor="#D1EFE4" />
                                    <Label Text="•• 4821" FontSize="15" FontAttributes="Bold" TextColor="White" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Padding="12" BackgroundColor="#21866E" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="Student saver" FontSize="12" TextColor="#D1EFE4" />
                                    <Label Text="•• 1904" FontSize="15" FontAttributes="Bold" TextColor="White" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="12">
                    <Label Text="Quick actions" FontSize="18" FontAttributes="Bold" TextColor="#173A33" />
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="9">
                        <VerticalStackLayout Spacing="7" HorizontalOptions="Center">
                            <Button Text="↗" Clicked="OnActionClicked" CommandParameter="Send money"
                                    BackgroundColor="#E4F2EC" TextColor="#08765B" CornerRadius="18" WidthRequest="56" HeightRequest="56" Padding="0" FontSize="24" />
                            <Label Text="Send" FontSize="12" TextColor="#455D56" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="7" HorizontalOptions="Center">
                            <Button Text="＋" Clicked="OnActionClicked" CommandParameter="Add money"
                                    BackgroundColor="#E4F2EC" TextColor="#08765B" CornerRadius="18" WidthRequest="56" HeightRequest="56" Padding="0" FontSize="24" />
                            <Label Text="Add" FontSize="12" TextColor="#455D56" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="7" HorizontalOptions="Center">
                            <Button Text="▤" Clicked="OnActionClicked" CommandParameter="Cards"
                                    BackgroundColor="#E4F2EC" TextColor="#08765B" CornerRadius="18" WidthRequest="56" HeightRequest="56" Padding="0" FontSize="21" />
                            <Label Text="Cards" FontSize="12" TextColor="#455D56" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="3" Spacing="7" HorizontalOptions="Center">
                            <Button Text="?" Clicked="OnAssistantClicked"
                                    BackgroundColor="#E4F2EC" TextColor="#08765B" CornerRadius="18" WidthRequest="56" HeightRequest="56" Padding="0" FontSize="22" />
                            <Label Text="Ask AI" FontSize="12" TextColor="#455D56" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Recent activity" FontSize="18" FontAttributes="Bold" TextColor="#173A33" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="See all" Clicked="OnAccountsClicked" BackgroundColor="Transparent"
                            TextColor="#08765B" Padding="8,4" FontSize="13" />
                </Grid>

                <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Transactions}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:BankTransactionDisplay">
                            <Grid ColumnDefinitions="44,*,Auto" Padding="0,12" ColumnSpacing="12">
                                <Border WidthRequest="42" HeightRequest="42" BackgroundColor="#EDF3F0" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                                    <Label Text="{Binding Icon}" FontSize="19" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#37685A" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" TextColor="#203A33" />
                                    <Label Text="{Binding Subtitle}" FontSize="12" TextColor="#75847E" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding Amount}" FontSize="14" FontAttributes="Bold"
                                       TextColor="{Binding AmountColor}" VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Border Padding="16" BackgroundColor="#E7F3EE" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Need a hand with money basics?" FontSize="14" FontAttributes="Bold" TextColor="#164A3B" />
                            <Label Text="Ask the StudentBank assistant a question." FontSize="12" TextColor="#587169" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Ask" Clicked="OnAssistantClicked" Style="{StaticResource PrimaryButtonStyle}"
                                Padding="14,8" FontSize="13" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
